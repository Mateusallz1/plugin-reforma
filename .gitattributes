* text=auto

# Preserve the non-reconstructible legacy bundle byte-for-byte.
legacy/mcp/server.mjs -text

*.cmd text eol=crlf
*.ps1 text eol=crlf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.csv text eol=lf
*.sha256 -text

# The archived MCP is forensic evidence. Preserve every file byte-for-byte,
# overriding the general text and line-ending rules above.
legacy/mcp/** -text
