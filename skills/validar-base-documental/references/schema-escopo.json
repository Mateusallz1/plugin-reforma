{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "br.com.planejamento-reforma-tributaria/uc-001/scope/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entity_ref",
    "establishment_ref",
    "entity_taxpayer_ids",
    "period",
    "objective",
    "document_families",
    "validation_policy",
    "analysis_cutoff"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "entity_ref": { "type": "string", "minLength": 1 },
    "establishment_ref": { "type": "string", "minLength": 1 },
    "entity_taxpayer_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[0-9]{14}$" }
    },
    "period": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
    "objective": { "const": "VALIDATE_DOCUMENT_BASE" },
    "document_families": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["NFE", "NFCE", "NFSE", "CTE"] }
    },
    "validation_policy": { "const": "DOCUMENTARY_INITIAL" },
    "report_population_policy": {
      "const": "COMPLEMENTARY",
      "default": "COMPLEMENTARY"
    },
    "analysis_cutoff": { "type": "string", "format": "date-time" }
  }
}
